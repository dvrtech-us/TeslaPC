# TeslaPC configuration — copy to ".env" and fill in. NEVER commit the real .env.
# The app loads ".env" from its own folder and from %ProgramData%\TeslaPC\.env
# (the latter wins, and survives rebuilds — put secrets there).

# Hostname for the publicly-trusted certificate (DNS A record -> 100.64.0.1).
TESLAPC_HTTPS_HOST=my.thelpers.com

# Cloudflare API token with Zone:Read + DNS:Edit on the zone (for ACME DNS-01).
TESLAPC_CF_TOKEN=your-cloudflare-token-here

# Let's Encrypt account contact (optional).
TESLAPC_ACME_EMAIL=you@example.com

# Folder the Files browser and media player read from (optional; default C:\video\).
TESLAPC_VIDEO_ROOT=C:\video\

# Max vertical pixels for the stream / live screen and video (optional; default 1080).
# Common values: 480, 720, 1080. Higher = sharper but more bandwidth. Also settable in the UI.
TESLAPC_STREAM_HEIGHT=1080

# Log verbosity: error | warn | info | debug (optional; default info). 'debug' echoes every
# mouse-move input and HTTP request — use only when troubleshooting.
TESLAPC_LOG_LEVEL=info

# Path to ffmpeg/ffprobe for in-app media playback (optional; a full path to ffmpeg.exe or the
# folder containing it). If unset, the app looks in its own folder, then PATH. VLC is the fallback.
# TESLAPC_FFMPEG=C:\ffmpeg\bin

# Use Let's Encrypt staging while testing (untrusted certs, no rate limits). Optional.
# TESLAPC_ACME_STAGING=1
